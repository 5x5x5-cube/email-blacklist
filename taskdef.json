{
  "family": "blacklist-v2",
  "executionRoleArn": "arn:aws:iam::982590066260:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "containerDefinitions": [
    {
      "name": "blacklist-container",
      "image": "<IMAGE1_URI>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "BEARER_TOKEN",
          "value": "6tFpnHrro6wjsZnd8roWQMsTffBPcitQy2BgeOBQMUQ"  
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql+psycopg2://postgres:panama2025@database-1.cejuea6k8hzl.us-east-1.rds.amazonaws.com:5432/postgres"
        },
        {
          "name": "FLASK_DEBUG",
          "value": "1"
        },
        {
          "name": "FLASK_ENV",
          "value": "development"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blacklist",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}